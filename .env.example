PORT=3000
NODE_ENV=development
DEMO_MODE=true
SESSION_SECRET=replace-this-with-a-long-random-secret-before-public-deploy
DATABASE_URL=postgres://deshbrain:deshbrain@localhost:5432/deshbrain
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# Optional LLM provider. If blank, Desh AI still works with its local brain.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=

# Google live-web grounding.
# GOOGLE_SEARCH_API_KEY + GOOGLE_SEARCH_CX enable Google Programmable Search results.
# Create a Programmable Search Engine and turn on "Search the entire web".
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_MODE=auto
GOOGLE_SEARCH_CACHE_MS=300000

# Google Maps Routes API (requires Google Cloud billing + Routes API enabled).
# Gives traffic-aware live ETA for Road Brain / Desh AI route questions.
GOOGLE_MAPS_API_KEY=

ALLOWED_ORIGINS=http://localhost:3000
